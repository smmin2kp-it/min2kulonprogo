---
import '../styles/global.css'
import { getCollection } from 'astro:content'
interface Props {
  title: string
  description?: string
}
const { title, description } = Astro.props

// Medsos tampil di footer (ikon + nama), diurutkan berdasarkan order collection.
const medsos = (await getCollection('medsos'))
