---
import Layout from '../../layouts/Layout.astro'
import PageHeader from '../../components/PageHeader.astro'
import { getCollection } from 'astro:content'
import { formatDate } from '../../lib/utils'

const berita = (await getCollection('berita'))
  .filter((b) => !b.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<Layout title="Berita — MIN 2 Kulon Progo">
  <PageHeader title="Berita Terkini" subtitle="Informasi dan kabar terbaru dari MIN 2 Kulon Progo" />
  <div class="mx-auto max-w-6xl px-4 py-12">
    {berita.length > 0 ? (
      <div class="grid gap-8 md:grid-cols-3">
        {berita.map((item) => (
          <a href={`/berita/${item.id}`} class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
            <div class="aspect-video w-full bg-hijau-100">
              {item.data.cover && <img src={item.data.cover} alt={item.data.title} class="size-full object-cover" loading="lazy" />}
            </div>
            <div class="p-4">
              <p class="text-xs text-slate-500">{formatDate(item.data.date)}</p>
              <h2 class="mt-1 font-semibold leading-snug text-slate-800 group-hover:text-hijau-700">{item.data.title}</h2>
              {item.data.excerpt && <p class="mt-2 line-clamp-2 text-sm text-slate-600">{item.data.excerpt}</p>}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-center text-slate-500">Belum ada berita. Segera hadir.</p>
    )}
  </div>
</Layout>
