---
import Layout from '../layouts/Layout.astro'
import HeroSlider from '../components/HeroSlider.astro'
import SelayangPandang from '../components/SelayangPandang.astro'
import Keunggulan from '../components/Keunggulan.astro'
import BeritaPreview from '../components/BeritaPreview.astro'
import GaleriPreview from '../components/GaleriPreview.astro'
import AplikasiLayanan from '../components/AplikasiLayanan.astro'
import FaqSection from '../components/FaqSection.astro'
---

<Layout title="MIN 2 Kulon Progo — Madrasah Ibtidaiyah Negeri 2 Kulon Progo">
  <!-- 1. Hero Carousel Slider & Floating Quick Stats Bar -->
  <HeroSlider />

  <!-- 2. Selayang Pandang (Profil Singkat & Akreditasi) -->
  <SelayangPandang />

  <!-- 3. Keunggulan MIN 2 Kulon Progo (6 Cards Grid) -->
  <Keunggulan />

  <!-- 4. Berita Terkini (Kabar Madrasah) -->
  <BeritaPreview />

  <!-- 5. Galeri Kegiatan Sekolah (Dokumentasi Kegiatan) -->
  <GaleriPreview />

  <!-- 6. Semua Aplikasi Kami (Layanan Digital) -->
  <AplikasiLayanan />

  <!-- 7. FAQ (Pertanyaan yang Sering Ditanyakan) -->
  <FaqSection />
</Layout>
