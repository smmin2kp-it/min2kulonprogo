---
import Layout from '../../layouts/Layout.astro'
import PageHeader from '../../components/PageHeader.astro'
import { getCollection } from 'astro:content'

const kurikulum = (await getCollection('kurikulum')).sort((a, b) => a.data.order - b.data.order)
---

<Layout title="Kurikulum — MIN 2 Kulon Progo">
  <PageHeader title="Kurikulum 2026/2027" subtitle="Dokumen Kurikulum Satuan Pendidikan (KSP) MIN 2 Kulon Progo" />
  <div class="mx-auto max-w-4xl px-4 py-12">
    <p class="mb-6 rounded-xl border border-hijau-200 bg-hijau-50 p-4 text-sm text-slate-700">
      Berikut isi lengkap Kurikulum Satuan Pendidikan MIN 2 Kulon Progo Tahun Ajaran 2026/2027, dipecah per bagian agar mudah dibaca.
    </p>
    {kurikulum.length > 0 ? (
      <div class="space-y-4">
        {kurikulum.map((k) => (
          <a href={`/kurikulum/${k.id}`} class="flex items-center justify-between rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-hijau-300 hover:shadow-md">
            <span class="font-semibold text-slate-800">{k.data.title}</span>
            <span class="text-hijau-700">→</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-slate-500">Isi kurikulum akan dimuat dari dokumen resmi. Segera hadir.</p>
    )}
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/kurikulum/01-pendahuluan" class="rounded-full bg-biru-900 px-6 py-3 font-semibold text-white hover:bg-biru-800">Mulai Baca: Pendahuluan</a>
    </div>
  </div>
</Layout>
