---
import Layout from '../../layouts/Layout.astro'
import PageHeader from '../../components/PageHeader.astro'
import { getCollection, render } from 'astro:content'

const halaman = (await getCollection('halaman')).sort((a, b) => a.data.order - b.data.order)
const res = await Promise.all(halaman.map(async (h) => {
  const { Content } = await render(h)
  return { ...h, Content }
}))
---

<Layout title="Halaman — MIN 2 Kulon Progo">
  <PageHeader title="Halaman" />
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="mb-10 flex flex-wrap gap-2">
      {halaman.map((h) => (
        <a href={`/halaman/${h.id}`} class="rounded-full bg-slate-100 px-4 py-1.5 text-sm text-slate-700 hover:bg-hijau-100">{h.data.title}</a>
      ))}
    </nav>
    {res.map((h) => (
      <article class="mb-10 overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-10 [&_h2]:mt-6 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-biru-900 [&_h3]:mt-5 [&_h3]:text-xl [&_h3]:font-semibold [&_table]:mt-4 [&_table]:w-full [&_table]:border-collapse [&_table]:text-sm [&_td]:border [&_td]:border-slate-300 [&_td]:px-3 [&_td]:py-2 [&_th]:border [&_th]:border-slate-300 [&_th]:bg-slate-50 [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_ul]:mt-2 [&_ul]:list-disc [&_ol]:mt-2 [&_ol]:list-decimal [&_li]:ml-6 [&_li]:mt-1 [&_p]:mt-2 [&_p]:leading-relaxed [&_p]:text-slate-600">
        <h2 class="mb-2 text-xl font-bold text-biru-900"><a href={`/halaman/${h.id}`} class="hover:underline">{h.data.title}</a></h2>
        <h.Content />
      </article>
    ))}
  </div>
</Layout>
