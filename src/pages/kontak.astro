---
import Layout from '../layouts/Layout.astro'
import PageHeader from '../components/PageHeader.astro'
import { getCollection, render } from 'astro:content'

const halaman = await getCollection('halaman')
const page = halaman.find((h) => h.id === 'kontak')!
const { Content } = await render(page)
---

<Layout title="Kontak — MIN 2 Kulon Progo">
  <PageHeader title="Hubungi Kami" subtitle="Silakan hubungi MIN 2 Kulon Progo untuk informasi lebih lanjut" />
  <div class="mx-auto max-w-4xl px-4 py-12">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-10 [&_h2]:mt-8 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-biru-900 [&_p]:mt-2 [&_p]:leading-relaxed [&_p]:text-slate-600">
      <Content />
    </div>
    <!-- Google Maps -->
    <div class="mt-8 overflow-hidden rounded-2xl border border-slate-200 shadow-sm">
      <iframe
        title="Lokasi MIN 2 Kulon Progo"
        src="https://www.google.com/maps?q=Dukuh,+Ngestiharjo,+Wates,+Kulon+Progo&output=embed"
        class="h-80 w-full"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
    <!-- Form kontak via WhatsApp -->
    <form
      class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-8"
      onsubmit="event.preventDefault(); const n=this.querySelector('[name=name]').value; const m=this.querySelector('[name=message]').value; const wa='6281234567890'; const t=encodeURIComponent('Assalamu\'alaikum, saya '+n+'.%0A%0A'+m); window.open('https://wa.me/'+wa+'?text='+t,'_blank');"
    >
      <!-- ponytail: ganti 6281234567890 dengan nomor WA sekolah asli -->
      <h2 class="mb-4 text-xl font-bold text-biru-900">Kirim Pesan via WhatsApp</h2>
      <div class="grid gap-4 md:grid-cols-2">
        <label class="block text-sm font-medium text-slate-700">
          Nama
          <input required name="name" type="text" placeholder="Nama Anda" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-hijau-500 focus:outline-none" />
        </label>
        <label class="block text-sm font-medium text-slate-700">
          Subjek
          <input name="subject" type="text" placeholder="Hal yang ingin ditanyakan" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-hijau-500 focus:outline-none" />
        </label>
      </div>
      <label class="mt-4 block text-sm font-medium text-slate-700">
        Pesan
        <textarea required name="message" rows="5" placeholder="Tulis pesan Anda..." class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-hijau-500 focus:outline-none"></textarea>
      </label>
      <button type="submit" class="mt-4 inline-flex items-center gap-2 rounded-full bg-hijau-700 px-6 py-2.5 font-semibold text-white hover:bg-hijau-800">
        <svg class="size-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.832-1.438A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a8 8 0 01-4.243-1.218l-.257-.157-2.857.857.857-2.857-.157-.257A8 8 0 1112 20z"/></svg>
        Kirim via WhatsApp
      </button>
    </form>
  </div>
</Layout>
