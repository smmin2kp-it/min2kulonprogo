---
import Layout from '../../layouts/Layout.astro'
import PageHeader from '../../components/PageHeader.astro'
import { getCollection, render } from 'astro:content'
import { formatDateShort } from '../../lib/utils'

export async function getStaticPaths() {
  const galeri = await getCollection('galeri')
  return galeri.map((g) => ({ params: { id: g.id } }))
}

const { id } = Astro.params
const galeri = await getCollection('galeri')
const entry = galeri.find((g) => g.id === id)
if (!entry) return Astro.redirect('/galeri')
const { Content } = await render(entry)
---

<Layout title={`${entry.data.title} — Galeri MIN 2 Kulon Progo`}>
  <PageHeader title="Galeri" />
  <div class="mx-auto max-w-6xl px-4 py-12">
    <p class="text-sm text-slate-500">{formatDateShort(entry.data.date)}</p>
    <h1 class="mt-1 text-3xl font-bold text-biru-900">{entry.data.title}</h1>
    {entry.data.description && <p class="mt-2 text-slate-600">{entry.data.description}</p>}
    <div class="mt-8 columns-2 gap-4 md:columns-3 [&>img]:mb-4 [&>img]:w-full [&>img]:rounded-xl [&>img]:break-inside-avoid">
      {entry.data.photos.map((p) => <img src={p} alt={`${entry.data.title} — foto`} class="hover:opacity-90" loading="lazy" />)}
    </div>
    <a href="/galeri" class="mt-10 inline-block font-semibold text-hijau-700 hover:underline">← Kembali ke Galeri</a>
  </div>
</Layout>
