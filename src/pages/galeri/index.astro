---
import Layout from '../../layouts/Layout.astro'
import PageHeader from '../../components/PageHeader.astro'
import { getCollection } from 'astro:content'
import { formatDateShort } from '../../lib/utils'

const galeri = (await getCollection('galeri')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<Layout title="Galeri — MIN 2 Kulon Progo">
  <PageHeader title="Galeri Kegiatan" subtitle="Dokumentasi kegiatan MIN 2 Kulon Progo" />
  <div class="mx-auto max-w-6xl px-4 py-12">
    {galeri.length > 0 ? (
      <div class="grid gap-8 md:grid-cols-3">
        {galeri.map((g) => (
          <a href={`/galeri/${g.id}`} class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
            <div class="aspect-video w-full bg-hijau-100">
              {g.data.photos[0] ? <img src={g.data.photos[0]} alt={g.data.title} class="size-full object-cover" loading="lazy" /> : null}
            </div>
            <div class="p-4">
              <h2 class="font-semibold text-slate-800 group-hover:text-hijau-700">{g.data.title}</h2>
              <p class="text-sm text-slate-500">{formatDateShort(g.data.date)} · {g.data.photos.length} foto</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-center text-slate-500">Galeri segera hadir.</p>
    )}
  </div>
</Layout>
