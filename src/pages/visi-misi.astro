---
import Layout from '../layouts/Layout.astro'
import PageHeader from '../components/PageHeader.astro'
import { getCollection, render } from 'astro:content'

const halaman = await getCollection('halaman')
const page = halaman.find((h) => h.id === 'visi-misi')!
const { Content } = await render(page)
---

<Layout title="Visi & Misi — MIN 2 Kulon Progo">
  <PageHeader title="Visi, Misi & Tujuan" />
  <div class="mx-auto max-w-4xl px-4 py-12">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:p-10 [&_h2]:mt-8 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-biru-900 [&_ul]:mt-2 [&_ul]:list-decimal [&_ol]:mt-2 [&_ol]:list-decimal [&_li]:ml-6 [&_li]:mt-1 [&_li]:leading-relaxed [&_p]:mt-2 [&_p]:leading-relaxed [&_p]:text-slate-600">
      <Content />
    </div>
  </div>
</Layout>
