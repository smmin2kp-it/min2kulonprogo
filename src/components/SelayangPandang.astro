---
import { getCollection } from 'astro:content'
const items = await getCollection('profilSingkat')
const d = items[0]?.data || {}
const tahunSekarang = new Date().getFullYear()
const lamaAbdi = tahunSekarang - (d.tahunBerdiri || 1980)
const badges = [
  { icon: d.badge1Icon, title: d.badge1Title, desc: d.badge1Desc, hover: 'hover:bg-emerald-50/50 hover:border-emerald-200' },
  { icon: d.badge2Icon, title: d.badge2Title, desc: d.badge2Desc, hover: 'hover:bg-emerald-50/50 hover:border-emerald-200' },
  { icon: d.badge3Icon, title: d.badge3Title, desc: d.badge3Desc, hover: 'hover:bg-amber-50/50 hover:border-amber-200' },
  { icon: d.badge4Icon, title: d.badge4Title, desc: d.badge4Desc, hover: 'hover:bg-blue-50/50 hover:border-blue-200' },
].filter(b => b.title)
---

<section class="my-16 sm:my-24 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">

      <!-- Kolom Kiri: Teks -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 rounded-full bg-orange-100 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-oren mb-3">
          {d.subjudul || 'Selayang Pandang'}
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-dark-blue leading-tight">
          {d.judul || 'MIN 2 Kulon Progo'}
        </h2>
        <div class="mt-3 h-1.5 w-24 bg-hijau-600 rounded-full"></div>

        <p class="mt-6 text-base sm:text-lg text-slate-600 leading-relaxed">
          {d.deskripsi1}
        </p>

        {d.deskripsi2 && (
          <p class="mt-4 text-base text-slate-600 leading-relaxed">
            {d.deskripsi2}
          </p>
        )}

        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {badges.map((b) => (
            <div class={`flex items-center gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-100 transition ${b.hover}`}>
              <span class="flex size-10 items-center justify-center rounded-xl bg-hijau-100 text-hijau-800 text-lg shrink-0">{b.icon}</span>
              <div>
                <h4 class="font-bold text-slate-800 text-sm">{b.title}</h4>
                <p class="text-xs text-slate-500">{b.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="/profil" class="inline-flex items-center gap-2 rounded-full bg-hijau-800 px-6 py-3 text-sm font-bold text-white shadow-md transition hover:bg-hijau-900 hover:gap-3">
            <span>Pelajari Profil Kami</span>
            <span>→</span>
          </a>
          <a href="/visi-misi" class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-50 hover:text-hijau-800">
            <span>Visi & Misi</span>
          </a>
        </div>
      </div>

      <!-- Kolom Kanan: Card Foto -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md lg:max-w-none rounded-3xl bg-white shadow-xl border border-slate-200/80 overflow-hidden">

          <div class="relative aspect-4/3 w-full bg-dark-blue overflow-hidden">
            <img
              src={d.foto || '/images/galeri/banner-1.jpg'}
              alt={`Gedung & Kegiatan Siswa ${d.judul || 'MIN 2 Kulon Progo'}`}
              class="size-full object-cover transition duration-700 hover:scale-105"
              onerror="this.onerror=null;this.src='/images/galeri/banner-2.jpg'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-dark-blue/90 via-dark-blue/20 to-transparent"></div>

            <div class="absolute top-4 left-4 flex items-center gap-2.5 rounded-2xl bg-dark-blue/90 backdrop-blur-md px-4 py-2 text-white border border-white/20 shadow-lg">
              <span class="flex size-9 items-center justify-center rounded-xl bg-kuning-400 font-black text-base text-hijau-950">
                {lamaAbdi}+
              </span>
              <div>
                <p class="text-[11px] font-extrabold uppercase tracking-wide text-kuning-400 leading-none">Tahun Mengabdi</p>
                <p class="text-[10px] text-slate-300 leading-tight mt-0.5">Sejak Tahun {d.tahunBerdiri || 1980}</p>
              </div>
            </div>

            <div class="absolute bottom-4 left-4 right-4 text-white">
              <span class="inline-block rounded-md bg-kuning-400 px-2.5 py-1 text-[11px] font-bold text-hijau-950 mb-1">
                {d.tagline || 'Madrasah Hebat Bermartabat'}
              </span>
              <p class="text-xs sm:text-sm font-semibold text-white/95 leading-snug">
                {d.taglineSub || 'Mendidik dengan Hati, Membina Generasi Islami'}
              </p>
            </div>
          </div>

          <div class="p-5 sm:p-6 bg-slate-50/70">
            <div class="grid grid-cols-2 gap-4 pb-4 border-b border-slate-200">
              <div>
                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Akreditasi</p>
                <p class="text-sm font-extrabold text-hijau-800 mt-0.5">{d.akreditasi || '-'}</p>
              </div>
              <div class="text-right">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">Nomor Statistik</p>
                <p class="text-sm font-bold font-mono text-slate-700 mt-0.5">{d.nsm || '-'}</p>
              </div>
            </div>

            <div class="pt-3.5 flex items-center justify-between text-xs text-slate-500">
              <span class="flex items-center gap-1">
                <span>📍</span> {d.lokasi || '-'}
              </span>
              <span class="font-semibold text-hijau-800">
                NPSN: {d.npsn || '-'}
              </span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
