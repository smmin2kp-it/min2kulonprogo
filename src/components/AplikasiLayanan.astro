---
import { getCollection } from 'astro:content'
const apps = (await getCollection('aplikasiLayanan')).sort((a, b) => a.data.order - b.data.order).map(a => ({
  name: a.data.name,
  fullName: a.data.fullName,
  desc: a.data.desc,
  icon: a.data.icon,
  url: a.data.url,
  badge: a.data.badge,
}));
---

<section class="my-16 sm:my-24 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-2xl mx-auto">
      <span class="inline-block rounded-full bg-blue-100 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-biru-700 mb-3">
        Layanan Digital
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-dark-blue">
        Semua Aplikasi Kami
      </h2>
      <div class="mt-3 h-1.5 w-20 bg-biru-700 mx-auto rounded-full"></div>
      <p class="mt-3 text-slate-600 text-sm sm:text-base">
        Akses cepat portal aplikasi, layanan administrasi kementerian, dan sistem pendukung pembelajaran madrasah.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      {apps.map((app) => (
        <a
          href={app.url}
          target={app.url.startsWith('http') ? '_blank' : '_self'}
          rel="noopener noreferrer"
          class="group rounded-2xl bg-slate-50 p-5 text-center border border-slate-200/80 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lg hover:border-hijau-500 hover:bg-white flex flex-col justify-between"
        >
          <div>
            <span class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-white text-3xl shadow-sm border border-slate-100 group-hover:scale-110 transition duration-300">
              {app.icon}
            </span>
            <span class="mt-3 inline-block rounded-full bg-slate-200/70 px-2.5 py-0.5 text-[10px] font-bold text-slate-700 group-hover:bg-hijau-100 group-hover:text-hijau-800 transition">
              {app.badge}
            </span>
            <h3 class="mt-2 text-sm font-bold text-slate-800 group-hover:text-hijau-800 transition">
              {app.name}
            </h3>
            <p class="mt-1 line-clamp-2 text-xs text-slate-500 leading-normal">
              {app.desc}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-200/60 flex items-center justify-center gap-1 text-[11px] font-semibold text-hijau-700">
            <span>Buka Portal</span>
            <span>↗</span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
