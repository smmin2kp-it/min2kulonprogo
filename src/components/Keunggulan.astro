---
// Keunggulan.astro — Grid Keunggulan Madrasah dari collection konten
import { getCollection } from 'astro:content'

const keunggulanList = (await getCollection('keunggulan'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((x) => x.data)
---

<section class="my-16 sm:my-24 bg-slate-50 py-16 sm:py-20 border-y border-slate-200/60">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Title Center -->
    <div class="text-center max-w-3xl mx-auto">
      <span class="inline-block rounded-full bg-hijau-100 px-4 py-1 text-xs font-bold uppercase tracking-wider text-hijau-800 mb-3">
        Kenapa Memilih Kami
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-dark-blue">
        Keunggulan MIN 2 Kulon Progo
      </h2>
      <div class="mt-3 h-1.5 w-24 bg-oren mx-auto rounded-full"></div>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        MIN 2 Kulon Progo berkomitmen menghadirkan ekosistem pendidikan Islam modern yang komprehensif, aman, dan berprestasi bagi setiap peserta didik.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="mt-12 sm:mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {keunggulanList.map((item) => (
        <div class={`group relative overflow-hidden rounded-2xl bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl border ${item.border}`}>
          <div class="flex items-center justify-between">
            <span class="flex size-14 items-center justify-center rounded-2xl bg-gradient-to-br from-slate-50 to-slate-100 text-3xl shadow-inner group-hover:scale-110 transition duration-300">
              {item.icon}
            </span>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
              {item.badge}
            </span>
          </div>

          <h3 class="mt-6 text-xl font-bold text-slate-800 group-hover:text-hijau-800 transition">
            {item.title}
          </h3>

          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            {item.desc}
          </p>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-2 text-xs font-bold text-hijau-700 opacity-0 group-hover:opacity-100 transition duration-300">
            <span>Pelajari selengkapnya</span>
            <span>→</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA banner inside section -->
    <div class="mt-12 sm:mt-16 rounded-2xl bg-gradient-to-r from-hijau-800 to-dark-blue p-8 sm:p-10 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-2xl sm:text-3xl font-bold">Siap Bergabung Bersama MIN 2 Kulon Progo?</h3>
        <p class="mt-2 text-sm sm:text-base text-emerald-100 max-w-xl">
          Daftarkan putra-putri Anda dan berikan pondasi pendidikan terbaik yang berkarakter islami dan berwawasan masa depan.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a href="/faq" class="rounded-full bg-kuning-400 px-6 py-3 text-sm font-bold text-hijau-950 shadow-md transition hover:bg-kuning-500 hover:scale-105">
          Informasi PPDB
        </a>
        <a href="/kontak" class="rounded-full border border-white/40 bg-white/10 px-6 py-3 text-sm font-bold text-white transition hover:bg-white hover:text-dark-blue">
          Hubungi Kami
        </a>
      </div>
    </div>

  </div>
</section>
