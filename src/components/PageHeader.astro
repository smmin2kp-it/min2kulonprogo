---
interface Props {
  title: string
  subtitle?: string
}
const { title, subtitle } = Astro.props
---

<section class="bg-hijau-800">
  <div class="mx-auto max-w-6xl px-4 py-16 text-center">
    <h1 class="text-balance text-3xl font-bold text-white md:text-5xl">{title}</h1>
    {subtitle && <p class="mx-auto mt-3 max-w-2xl text-hijau-50/80">{subtitle}</p>}
  </div>
</section>
