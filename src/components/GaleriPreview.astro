---
// GaleriPreview.astro — Galeri Kegiatan Sekolah ala SD Muh Sapen
import { getCollection } from 'astro:content'

const galeri = (await getCollection('galeri')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<section class="my-16 sm:my-24 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-2xl mx-auto">
      <span class="inline-block rounded-full bg-emerald-100 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-hijau-800 mb-3">
        Dokumentasi
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-dark-blue">
        Galeri Kegiatan Sekolah
      </h2>
      <div class="mt-3 h-1.5 w-24 bg-dark-blue mx-auto rounded-full"></div>
      <p class="mt-3 text-slate-600 text-sm sm:text-base">
        Momen-momen inspiratif, kegiatan belajar mengajar, lomba, dan kreativitas siswa MIN 2 Kulon Progo.
      </p>
    </div>

    {galeri.length > 0 ? (
      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {galeri.slice(0, 6).map((item) => {
          const cover = item.data.photos[0] || '/images/galeri/kegiatan-adiwiyata-1.svg';
          const count = item.data.photos.length;
          const dateFormatted = new Date(item.data.date).toLocaleDateString('id-ID', {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          });

          return (
            <a
              href={`/galeri/${item.id}`}
              class="group relative overflow-hidden rounded-2xl bg-slate-900 shadow-md transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl block aspect-4/3"
            >
              <img
                src={cover}
                alt={item.data.title}
                class="size-full object-cover transition duration-500 group-hover:scale-110 opacity-90 group-hover:opacity-100"
                loading="lazy"
              />

              <div class="absolute inset-0 bg-gradient-to-t from-dark-blue/95 via-dark-blue/40 to-transparent"></div>

              <!-- Top Photo Count Badge -->
              <div class="absolute top-3 right-3 rounded-full bg-black/60 backdrop-blur-sm px-3 py-1 text-xs font-semibold text-white flex items-center gap-1.5 border border-white/20">
                <span>📸</span>
                <span>{count} Foto</span>
              </div>

              <!-- Bottom Content -->
              <div class="absolute bottom-4 left-4 right-4 text-white">
                <p class="text-[11px] font-medium text-emerald-300 mb-1">{dateFormatted}</p>
                <h3 class="text-base font-bold text-white group-hover:text-kuning-400 transition leading-snug line-clamp-2">
                  {item.data.title}
                </h3>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="mt-8 text-center p-8 rounded-2xl bg-slate-50 border border-slate-200">
        <p class="text-slate-500">Galeri foto sedang dalam persiapan.</p>
      </div>
    )}

    <div class="mt-12 text-center">
      <a
        href="/galeri"
        class="inline-flex items-center gap-2 rounded-full border-2 border-dark-blue px-7 py-3 text-sm font-bold text-dark-blue transition hover:bg-dark-blue hover:text-white"
      >
        <span>Buka Semua Galeri</span>
        <span>→</span>
      </a>
    </div>

  </div>
</section>
